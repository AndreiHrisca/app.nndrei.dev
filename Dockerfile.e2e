# Browser checks only: the Playwright image brings Chromium/WebKit and their system
# libraries; the app's own dependencies are installed on top in a virtualenv.
FROM mcr.microsoft.com/playwright:v1.50.0-noble
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv libpangoft2-1.0-0 fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
ENV VIRTUAL_ENV=/venv PATH=/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.lock .
RUN python3 -m venv /venv && pip install --no-cache-dir -r requirements.lock playwright==1.50.0
WORKDIR /app
