# Generate a unique secret before deploying. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
POSTGRES_DB=nndrei
POSTGRES_USER=nndrei
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgres://nndrei:replace-with-a-database-password@db:5432/nndrei
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
# Enable only behind your trusted TLS reverse proxy; it must replace X-Forwarded-Proto.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=nndrei <no-reply@example.com>
ADMIN_EMAIL=admin@example.com
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
GOOGLE_PLACES_API_KEY=
PLACES_MONTHLY_LIMIT=800
PLACES_WEEKLY_REFRESH=False
PROPOSAL_LINK_MAX_AGE=604800
