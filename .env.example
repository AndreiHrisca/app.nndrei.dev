# Generate a unique secret before deploying. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
POSTGRES_DB=nndrei
POSTGRES_USER=nndrei
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgres://nndrei:replace-with-a-database-password@db:5432/nndrei
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
# Enable only behind your trusted TLS reverse proxy; it must replace X-Forwarded-Proto.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# True only behind Caddy with no public app port: the card-code limit then counts per visitor IP.
TRUST_X_FORWARDED_FOR=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=nndrei <no-reply@example.com>
ADMIN_EMAIL=admin@example.com
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
GOOGLE_PLACES_API_KEY=
PLACES_MONTHLY_LIMIT=800
PLACES_WEEKLY_REFRESH=False
PLACES_REFRESH_MIN_DAYS=7
PLACES_CELL_KM=1.5
PLACES_SEARCH_BUDGET=60
PLACES_CONFIRM_ABOVE=30
GEO_USER_AGENT=nndrei-app/1.0 (+https://app.nndrei.dev)
PROPOSAL_LINK_MAX_AGE=604800
TRUSTED_DEVICE_DAYS=30
# Consultas from nndrei.dev (inbox-sync service). Leave both empty to skip Telegram.
PORTFOLIO_INBOX=/portfolio/portfolio.sqlite3
INQUIRY_SYNC_INTERVAL=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
